digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Bias, variance and the complexity trade-off";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
er [label="expected error on NEW data\n= bias^2 + variance + noise", fillcolor="#FFE9D2", color="#D9822B"];
b [label="bias: model too simple\n=> underfitting", fillcolor="#DCE9FF", color="#3B6EDC"];
v [label="variance: model chases noise\n=> overfitting", fillcolor="#FADBD8", color="#B03A2E"];
n [label="irreducible noise\n(cannot be removed)", fillcolor="white", color="#666666"];
up [label="more flexible model:\nbias falls, variance rises", fillcolor="#FFF3C4", color="#C9A100"];
fx1 [label="fight bias: richer model,\nbetter features", fillcolor="#DFF3E4", color="#2E8B57"];
fx2 [label="fight variance: more data, regularization,\nensembles, simpler model", fillcolor="#DFF3E4", color="#2E8B57"];
er -> b; er -> v; er -> n; b -> up [style=dashed]; v -> up [style=dashed]; b -> fx1; v -> fx2;
}
