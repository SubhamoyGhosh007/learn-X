digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Matrices: many dot products at once, and special directions";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
X [label="X: m samples x n features", fillcolor="#DCE9FF", color="#3B6EDC"];
w [label="w: n weights", fillcolor="#DCE9FF", color="#3B6EDC"];
r [label="Xw: m predictions\n(row i of X dot w)", fillcolor="#DFF3E4", color="#2E8B57"];
rule [label="shape rule: (m x n)(n x p) = (m x p)\nthe two inner sizes must match", fillcolor="#FFF3C4", color="#C9A100"];
A [label="square matrix A\n(a transformation of space)", fillcolor="#FFE9D2", color="#D9822B"];
e [label="eigenvector v:  A v = lambda v\nA only stretches v, never turns it", fillcolor="#EBDFFB", color="#7A4FC2"];
pca [label="PCA uses the eigenvectors of the\ncovariance matrix as its axes", fillcolor="#DFF3E4", color="#2E8B57"];
inv [label="inverse: A A^-1 = I\nsolves  X^T X w = X^T y", fillcolor="#EEEEEE", color="#444444"];
X -> r; w -> r; r -> rule [style=dashed]; A -> e -> pca; A -> inv [style=dashed];
}
