digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Support vector machine: the widest street between classes";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
d [label="labeled points  y = +1 / -1", fillcolor="#DCE9FF", color="#3B6EDC"];
h [label="hyperplane  w . x + b = 0", fillcolor="#DFF3E4", color="#2E8B57"];
mg [label="margin = 2 / |w|\nmaximize margin = minimize |w|", fillcolor="#FFE9D2", color="#D9822B"];
sv [label="support vectors: the points on the margin\n(only they define the boundary)", fillcolor="#FFF3C4", color="#C9A100"];
sf [label="soft margin: allow violations,\npay C per unit of slack", fillcolor="#DFF3E4", color="#2E8B57"];
c [label="large C: narrow margin, fits tightly\nsmall C: wide margin, smoother", fillcolor="#EBDFFB", color="#7A4FC2"];
hl [label="same as hinge loss + L2 penalty", fillcolor="white", color="#666666"];
d -> h -> mg -> sv; mg -> sf -> c; sf -> hl [style=dashed];
}
