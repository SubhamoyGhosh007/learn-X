digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Logistic regression: from features to a probability";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
x [label="features x", fillcolor="#DCE9FF", color="#3B6EDC"];
z [label="score  z = w . x + b", fillcolor="#DFF3E4", color="#2E8B57"];
s [label="sigmoid  p = 1 / (1 + e^-z)\nsquashes to (0, 1)", fillcolor="#FFE9D2", color="#D9822B"];
th [label="p > threshold (0.5)?", fillcolor="#FFF3C4", color="#C9A100", shape=diamond, margin="0.04,0.04"];
c1 [label="predict class 1", fillcolor="#DFF3E4", color="#2E8B57"];
c0 [label="predict class 0", fillcolor="#FADBD8", color="#B03A2E"];
ls [label="loss: log-loss\n-[y ln p + (1-y) ln(1-p)]", fillcolor="#EBDFFB", color="#7A4FC2"];
gr [label="gradient = (1/m) X^T (p - y)\nthen w = w - alpha * gradient", fillcolor="#EBDFFB", color="#7A4FC2"];
x -> z -> s -> th; th -> c1 [label=" yes"]; th -> c0 [label=" no"]; s -> ls [style=dashed]; ls -> gr [style=dashed];
}
