digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Maximum likelihood: pick the parameters that make the data most probable";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
d [label="observed data", fillcolor="#DCE9FF", color="#3B6EDC"];
m [label="probabilistic model with parameters theta", fillcolor="#DCE9FF", color="#3B6EDC"];
l [label="likelihood L(theta) = P(data | theta)", fillcolor="#DFF3E4", color="#2E8B57"];
lg [label="take logs: products become sums\nlog-likelihood", fillcolor="#DFF3E4", color="#2E8B57"];
mx [label="maximize over theta  ->  theta-hat", fillcolor="#FFE9D2", color="#D9822B"];
g [label="Gaussian noise\n=> minimize squared error\n(linear regression)", fillcolor="#EBDFFB", color="#7A4FC2"];
bn [label="Bernoulli labels\n=> minimize log-loss\n(logistic regression)", fillcolor="#EBDFFB", color="#7A4FC2"];
d -> l; m -> l; l -> lg -> mx; mx -> g [style=dashed]; mx -> bn [style=dashed];
}
