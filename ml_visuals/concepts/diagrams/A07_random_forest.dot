digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Random forest: many decorrelated trees, averaged";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
d [label="training data", fillcolor="#EEEEEE", color="#444444"];
bs [label="draw B bootstrap samples\n(rows with replacement)", fillcolor="#DFF3E4", color="#2E8B57"];
t1 [label="deep tree 1", fillcolor="#DCE9FF", color="#3B6EDC"];
t2 [label="deep tree 2", fillcolor="#DCE9FF", color="#3B6EDC"];
t3 [label="deep tree B", fillcolor="#DCE9FF", color="#3B6EDC"];
rf [label="at every split each tree sees only\na random subset of features", fillcolor="#FFF3C4", color="#C9A100"];
ag [label="classification: vote\nregression: average", fillcolor="#FFE9D2", color="#D9822B"];
oob [label="out-of-bag rows (about 37%)\n= free validation estimate", fillcolor="#EBDFFB", color="#7A4FC2"];
imp [label="permutation importance\nranks the features", fillcolor="#EBDFFB", color="#7A4FC2"];
d -> bs; bs -> t1; bs -> t2; bs -> t3; rf -> t1 [style=dashed]; rf -> t2 [style=dashed]; rf -> t3 [style=dashed]; t1 -> ag; t2 -> ag; t3 -> ag; bs -> oob [style=dashed]; ag -> imp [style=dashed];
}
