digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Gradient: all the slopes together point uphill";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
L [label="loss L(w1, w2, ...)", fillcolor="#DCE9FF", color="#3B6EDC"];
pd [label="partial derivative per parameter\ndL/dw1, dL/dw2, ... (others held fixed)", fillcolor="#DFF3E4", color="#2E8B57"];
gr [label="gradient vector\n(dL/dw1, dL/dw2, ...)", fillcolor="#FFE9D2", color="#D9822B"];
up [label="points in the direction of\nsteepest INCREASE of L", fillcolor="white", color="#666666"];
st [label="step the opposite way:\nw = w - alpha * gradient", fillcolor="#FFF3C4", color="#C9A100"];
lp [label="repeat until the loss stops falling", fillcolor="#DFF3E4", color="#2E8B57"];
L -> pd -> gr -> up; gr -> st -> lp; lp -> L [style=dashed, label=" new w"];
}
