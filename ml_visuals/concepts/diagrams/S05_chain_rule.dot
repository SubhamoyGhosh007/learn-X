digraph G { rankdir=LR; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Chain rule: derivatives multiply along a chain of functions";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
x [label="x", fillcolor="#EEEEEE", color="#444444"];
u [label="u = g(x)", fillcolor="#DCE9FF", color="#3B6EDC"];
y [label="y = f(u)", fillcolor="#DCE9FF", color="#3B6EDC"];
a [label="du/dx = g'(x)", fillcolor="#DFF3E4", color="#2E8B57"];
bb [label="dy/du = f'(u)", fillcolor="#DFF3E4", color="#2E8B57"];
r [label="dy/dx = (dy/du) * (du/dx)", fillcolor="#FFE9D2", color="#D9822B"];
ml [label="In ML: loss <- prediction <- weights.\nMultiply the slopes along that chain to get dLoss/dWeight\n(this is how every gradient in Part B is derived)", fillcolor="#EBDFFB", color="#7A4FC2"];
x -> u [label=" g"]; u -> y [label=" f"]; u -> a [style=dashed, arrowhead=none]; y -> bb [style=dashed, arrowhead=none]; a -> r; bb -> r; r -> ml [style=dashed];
}
