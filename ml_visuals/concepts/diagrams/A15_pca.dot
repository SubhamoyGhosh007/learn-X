digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="PCA: from covariance to a smaller representation";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
x [label="data matrix X (m x n)", fillcolor="#DCE9FF", color="#3B6EDC"];
sc [label="center (and standardize) each feature", fillcolor="#FFF3C4", color="#C9A100"];
cv [label="covariance matrix (n x n)", fillcolor="#DFF3E4", color="#2E8B57"];
eg [label="eigen-decomposition (or SVD)\nS w = lambda w", fillcolor="#DFF3E4", color="#2E8B57"];
so [label="sort eigenvectors by eigenvalue\n(variance captured)", fillcolor="#DFF3E4", color="#2E8B57"];
k [label="keep top k: explained variance\n90 to 99%, or a scree-plot elbow", fillcolor="#FFF3C4", color="#C9A100"];
pj [label="project:  Z = X W   (m x k)", fillcolor="#FFE9D2", color="#D9822B"];
cav [label="linear and unsupervised; scale first;\nuse t-SNE / UMAP only for plotting", fillcolor="#EBDFFB", color="#7A4FC2"];
x -> sc -> cv -> eg -> so -> k -> pj; pj -> cav [style=dashed];
}
