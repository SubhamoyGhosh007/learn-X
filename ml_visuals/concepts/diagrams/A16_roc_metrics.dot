digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Confusion matrix, metrics and the ROC curve";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
cm [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD BORDER="0"></TD><TD BGCOLOR="#EEEEEE"><B>predicted +</B></TD><TD BGCOLOR="#EEEEEE"><B>predicted -</B></TD></TR><TR><TD BGCOLOR="#EEEEEE"><B>actual +</B></TD><TD BGCOLOR="#D5F5E3">TP</TD><TD BGCOLOR="#FADBD8">FN (miss)</TD></TR><TR><TD BGCOLOR="#EEEEEE"><B>actual -</B></TD><TD BGCOLOR="#FADBD8">FP (false alarm)</TD><TD BGCOLOR="#D5F5E3">TN</TD></TR></TABLE>>, fillcolor="white", color="#666666"];
pre [label="precision = TP / (TP + FP)\nhow trustworthy a positive call is", fillcolor="#DCE9FF", color="#3B6EDC"];
rec [label="recall = TP / (TP + FN)\nhow many real positives we catch", fillcolor="#DCE9FF", color="#3B6EDC"];
f1 [label="F1 = 2PR / (P + R)", fillcolor="#FFE9D2", color="#D9822B"];
acc [label="accuracy = (TP + TN) / total\nmisleading when classes are imbalanced", fillcolor="white", color="#666666"];
th [label="slide the decision threshold:\ntrade precision against recall", fillcolor="#FFF3C4", color="#C9A100"];
roc [label="ROC: plot recall (TPR) against FPR\nAUC = chance a random positive outranks\na random negative", fillcolor="#DFF3E4", color="#2E8B57"];
pr [label="imbalanced data: use the\nprecision-recall curve", fillcolor="#EBDFFB", color="#7A4FC2"];
cm -> pre; cm -> rec; cm -> acc; pre -> f1; rec -> f1; th -> roc; th -> pr [style=dashed]; rec -> roc [style=dashed];
}
