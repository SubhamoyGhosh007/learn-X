digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Dot product: a weighted sum and a measure of alignment";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
a [label="vector a\n(a1, a2, ..., an)", fillcolor="#DCE9FF", color="#3B6EDC"];
b [label="vector b\n(b1, b2, ..., bn)", fillcolor="#DCE9FF", color="#3B6EDC"];
m [label="multiply matching entries\na1*b1, a2*b2, ...", fillcolor="#DFF3E4", color="#2E8B57"];
s [label="add them up\na.b = a1b1 + ... + anbn", fillcolor="#DFF3E4", color="#2E8B57"];
c [label="same as |a| |b| cos(angle)", fillcolor="#FFE9D2", color="#D9822B"];
p [label="a.b > 0\npoint the same way", fillcolor="white", color="#666666"];
z [label="a.b = 0\nperpendicular", fillcolor="white", color="#666666"];
n [label="a.b < 0\npoint opposite ways", fillcolor="white", color="#666666"];
ml [label="In ML: w . x = weighted sum of features\n(the core of every linear model)", fillcolor="#EBDFFB", color="#7A4FC2"];
a -> m; b -> m; m -> s -> c; c -> p; c -> z; c -> n; s -> ml [style=dashed];
}
