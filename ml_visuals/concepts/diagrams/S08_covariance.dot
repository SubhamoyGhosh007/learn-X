digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Variance, covariance and correlation";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
x [label="feature x", fillcolor="#DCE9FF", color="#3B6EDC"];
y [label="feature y", fillcolor="#DCE9FF", color="#3B6EDC"];
dx [label="deviations from the mean\nxi - mean(x),  yi - mean(y)", fillcolor="#DFF3E4", color="#2E8B57"];
pr [label="multiply paired deviations", fillcolor="#DFF3E4", color="#2E8B57"];
av [label="average = covariance\n>0 move together, <0 opposite", fillcolor="#FFE9D2", color="#D9822B"];
sc [label="divide by sigma_x * sigma_y", fillcolor="#FFF3C4", color="#C9A100"];
r [label="correlation r in [-1, +1]\nunit-free strength of the LINEAR link", fillcolor="#FFE9D2", color="#D9822B"];
var [label="variance of one feature =\ncovariance of x with itself", fillcolor="white", color="#666666"];
cm [label="covariance matrix of all features\n-> eigenvectors -> PCA", fillcolor="#EBDFFB", color="#7A4FC2"];
x -> dx; y -> dx; dx -> pr -> av -> sc -> r; av -> var [style=dashed]; av -> cm [style=dashed];
}
