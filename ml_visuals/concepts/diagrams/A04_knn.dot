digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="k-Nearest Neighbors: ask the closest examples";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
q [label="new point to predict", fillcolor="#DCE9FF", color="#3B6EDC"];
sc [label="scale features first", fillcolor="#FFF3C4", color="#C9A100"];
ds [label="distance to EVERY stored training point\nEuclidean / Manhattan / cosine", fillcolor="#DFF3E4", color="#2E8B57"];
pk [label="pick the k closest", fillcolor="#DFF3E4", color="#2E8B57"];
vt [label="classification: majority vote\nregression: average of targets", fillcolor="#FFE9D2", color="#D9822B"];
out [label="prediction", fillcolor="#DFF3E4", color="#2E8B57"];
kk [label="small k: wiggly, overfits\nlarge k: smooth, underfits\n(choose k by cross-validation)", fillcolor="#EBDFFB", color="#7A4FC2"];
q -> sc -> ds -> pk -> vt -> out; pk -> kk [style=dashed];
}
