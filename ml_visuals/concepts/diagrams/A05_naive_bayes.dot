digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Naive Bayes: Bayes rule with an independence shortcut";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
x [label="features x1 ... xn", fillcolor="#DCE9FF", color="#3B6EDC"];
pr [label="class prior P(c)\n(class frequencies)", fillcolor="#DCE9FF", color="#3B6EDC"];
lk [label="per-feature likelihoods P(xj | c)\nGaussian / multinomial / Bernoulli", fillcolor="#DFF3E4", color="#2E8B57"];
nv [label="naive: assume features are independent\ngiven the class -> multiply them", fillcolor="#FFF3C4", color="#C9A100"];
sc [label="score(c) = P(c) * product of P(xj | c)\n(use logs to avoid underflow)", fillcolor="#FFE9D2", color="#D9822B"];
ar [label="predict the class with the highest score", fillcolor="#DFF3E4", color="#2E8B57"];
ls [label="Laplace smoothing: add 1 to counts\nso no probability is exactly 0", fillcolor="#EBDFFB", color="#7A4FC2"];
x -> lk; pr -> sc; lk -> nv -> sc -> ar; lk -> ls [style=dashed];
}
