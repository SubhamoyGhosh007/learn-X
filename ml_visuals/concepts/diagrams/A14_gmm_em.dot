digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Gaussian mixture model fitted by EM";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
in [label="initialize means, covariances, weights", fillcolor="#EEEEEE", color="#444444"];
e [label="E-step: for each point compute the\nprobability it came from each component\n(responsibilities)", fillcolor="#DCE9FF", color="#3B6EDC"];
m [label="M-step: re-estimate each component using\nresponsibilities as soft weights", fillcolor="#DFF3E4", color="#2E8B57"];
ll [label="log-likelihood improved?", fillcolor="#FFF3C4", color="#C9A100", shape=diamond, margin="0.04,0.04"];
out [label="soft cluster memberships +\nelliptical clusters", fillcolor="#FFE9D2", color="#D9822B"];
cmp [label="vs k-means: soft assignments,\nflexible shapes; choose k with BIC", fillcolor="#EBDFFB", color="#7A4FC2"];
in -> e -> m -> ll; ll -> e [label=" yes"]; ll -> out [label=" converged"]; out -> cmp [style=dashed];
}
