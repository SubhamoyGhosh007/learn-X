digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Decision tree: grow by repeatedly choosing the best split";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
n [label="node with some samples", fillcolor="#DCE9FF", color="#3B6EDC"];
tr [label="try every feature and every threshold", fillcolor="#DFF3E4", color="#2E8B57"];
sc [label="score each split by impurity drop\nentropy / Gini / variance", fillcolor="#DFF3E4", color="#2E8B57"];
bs [label="take the split with the highest\ninformation gain", fillcolor="#FFE9D2", color="#D9822B"];
sp [label="send samples left / right", fillcolor="#DFF3E4", color="#2E8B57"];
st [label="stop? pure node, max depth,\nmin samples reached", fillcolor="#FFF3C4", color="#C9A100", shape=diamond, margin="0.04,0.04"];
lf [label="leaf: predict majority class\n(or mean for regression)", fillcolor="#DFF3E4", color="#2E8B57"];
pr [label="too deep => overfits:\nlimit depth or prune", fillcolor="#EBDFFB", color="#7A4FC2"];
n -> tr -> sc -> bs -> sp -> st; st -> lf [label=" yes"]; st -> n [label=" no: recurse\n on each child"]; lf -> pr [style=dashed];
}
