digraph G { rankdir=TB; bgcolor="white"; nodesep=0.35; ranksep=0.42; pad=0.3; labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="DBSCAN: clusters are dense regions";
node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.16,0.09", penwidth=1.4];
edge [fontname="Helvetica", fontsize=10.5, color="#555555", arrowsize=0.8];
p [label="parameters: radius eps, min_samples", fillcolor="#FFF3C4", color="#C9A100"];
cn [label="count neighbors within eps of each point", fillcolor="#DFF3E4", color="#2E8B57"];
cr [label=">= min_samples neighbors:\nCORE point", fillcolor="#DCE9FF", color="#3B6EDC"];
bd [label="within eps of a core point\nbut not core: BORDER point", fillcolor="white", color="#666666"];
ns [label="neither: NOISE (label -1)", fillcolor="#FADBD8", color="#B03A2E"];
ch [label="link core points that are within eps\nof each other -> grow a cluster", fillcolor="#FFE9D2", color="#D9822B"];
out [label="arbitrary-shaped clusters + outliers\n(no k needed)", fillcolor="#DFF3E4", color="#2E8B57"];
p -> cn; cn -> cr; cn -> bd; cn -> ns; cr -> ch -> out; bd -> ch [style=dashed];
}
