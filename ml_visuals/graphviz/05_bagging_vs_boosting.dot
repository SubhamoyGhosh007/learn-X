digraph ens {
  rankdir=LR; bgcolor="white"; nodesep=0.25; ranksep=0.45; pad=0.3; compound=true;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11.5, margin="0.12,0.07", penwidth=1.3];
  edge [fontname="Helvetica", fontsize=10, color="#555555", arrowsize=0.75];
  labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Two ways to combine trees";
  subgraph cluster_bag { label="Bagging / Random forest: parallel, reduces variance"; style="rounded,filled"; fillcolor="#F3F8FF"; color="#3B6EDC"; fontname="Helvetica-Bold"; fontsize=12;
    d1 [label="Training data", fillcolor="#EEEEEE", color="#444444"];
    b1 [label="Bootstrap sample 1", fillcolor="#DCE9FF", color="#3B6EDC"];
    b2 [label="Bootstrap sample 2", fillcolor="#DCE9FF", color="#3B6EDC"];
    b3 [label="Bootstrap sample 3", fillcolor="#DCE9FF", color="#3B6EDC"];
    t1 [label="Deep tree 1\n(random feature subsets)", fillcolor="white", color="#3B6EDC"];
    t2 [label="Deep tree 2", fillcolor="white", color="#3B6EDC"];
    t3 [label="Deep tree 3", fillcolor="white", color="#3B6EDC"];
    avg [label="Average / vote", fillcolor="#FFE9D2", color="#D9822B"];
    d1 -> b1; d1 -> b2; d1 -> b3; b1 -> t1; b2 -> t2; b3 -> t3; t1 -> avg; t2 -> avg; t3 -> avg;
  }
  subgraph cluster_boost { label="Gradient boosting: sequential, reduces bias"; style="rounded,filled"; fillcolor="#F4FBF6"; color="#2E8B57"; fontname="Helvetica-Bold"; fontsize=12;
    d2 [label="Training data", fillcolor="#EEEEEE", color="#444444"];
    s0 [label="Start: predict\nthe mean", fillcolor="#DFF3E4", color="#2E8B57"];
    g1 [label="Shallow tree 1\nfits residuals", fillcolor="white", color="#2E8B57"];
    g2 [label="Shallow tree 2\nfits remaining residuals", fillcolor="white", color="#2E8B57"];
    g3 [label="Shallow tree 3 ...", fillcolor="white", color="#2E8B57"];
    sum [label="Sum of trees,\neach scaled by learning rate", fillcolor="#FFE9D2", color="#D9822B"];
    d2 -> s0; s0 -> g1 [label="errors"]; g1 -> g2 [label="errors"]; g2 -> g3 [label="errors"]; g3 -> sum;
  }
}
