digraph pipe {
  rankdir=LR; bgcolor="white"; nodesep=0.28; ranksep=0.5; pad=0.3; compound=true;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11.5, margin="0.13,0.08", penwidth=1.3];
  edge [color="#555555", arrowsize=0.75, fontname="Helvetica", fontsize=10];
  labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="A scikit-learn Pipeline with ColumnTransformer";
  raw [label="Raw table\nnumeric + categorical\n+ missing values", fillcolor="#EEEEEE", color="#444444"];
  subgraph cluster_ct { label="ColumnTransformer (fit on training folds only)"; style="rounded,filled"; fillcolor="#F4FBF6"; color="#2E8B57"; fontname="Helvetica-Bold"; fontsize=11.5;
    n1 [label="num columns:\nSimpleImputer(median)", fillcolor="white", color="#2E8B57"];
    n2 [label="StandardScaler", fillcolor="white", color="#2E8B57"];
    c1 [label="cat columns:\nSimpleImputer(most_frequent)", fillcolor="white", color="#2E8B57"];
    c2 [label="OneHotEncoder\n(handle_unknown=ignore)", fillcolor="white", color="#2E8B57"];
    n1 -> n2; c1 -> c2;
  }
  join [label="Numeric matrix", fillcolor="#DCE9FF", color="#3B6EDC"];
  model [label="Model\n(RandomForest / XGBoost /\nLogisticRegression)", fillcolor="#FFE9D2", color="#D9822B"];
  out [label="Predictions", fillcolor="#D5F5E3", color="#2E8B57"];
  raw -> n1; raw -> c1; n2 -> join; c2 -> join; join -> model -> out;
}
