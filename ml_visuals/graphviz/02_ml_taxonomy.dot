digraph taxonomy {
  rankdir=LR; bgcolor="white"; nodesep=0.18; ranksep=0.55; pad=0.3;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=12, margin="0.14,0.07", penwidth=1.3];
  edge [color="#777777", arrowsize=0.7];
  labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="A map of classical machine learning";
  ml [label="Machine\nlearning", fillcolor="#EEEEEE", color="#444444", fontsize=14];
  sup [label="Supervised\n(labels given)", fillcolor="#DCE9FF", color="#3B6EDC"];
  uns [label="Unsupervised\n(no labels)", fillcolor="#DFF3E4", color="#2E8B57"];
  rl  [label="Reinforcement\n(reward signal)\nnot covered in depth", fillcolor="#F3F3F3", color="#999999", fontcolor="#666666"];
  reg [label="Regression\n(predict a number)", fillcolor="#EAF1FF", color="#3B6EDC"];
  cls [label="Classification\n(predict a category)", fillcolor="#EAF1FF", color="#3B6EDC"];
  clu [label="Clustering", fillcolor="#EBF8EF", color="#2E8B57"];
  dim [label="Dimensionality\nreduction", fillcolor="#EBF8EF", color="#2E8B57"];
  ml -> sup; ml -> uns; ml -> rl;
  sup -> reg; sup -> cls; uns -> clu; uns -> dim;
  lin [label="Linear regression\nRidge / Lasso", fillcolor="white", color="#3B6EDC"];
  rtree [label="Regression trees\nForests, Boosting\nk-NN, SVR", fillcolor="white", color="#3B6EDC"];
  log [label="Logistic regression\nNaive Bayes", fillcolor="white", color="#3B6EDC"];
  ctree [label="Decision trees\nForests, Boosting\nk-NN, SVM", fillcolor="white", color="#3B6EDC"];
  km [label="k-means\nHierarchical\nDBSCAN, GMM", fillcolor="white", color="#2E8B57"];
  pca [label="PCA\nLDA\n(t-SNE / UMAP to plot)", fillcolor="white", color="#2E8B57"];
  reg -> lin; reg -> rtree; cls -> log; cls -> ctree; clu -> km; dim -> pca;
}
