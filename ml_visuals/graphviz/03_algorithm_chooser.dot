digraph chooser {
  rankdir=TB; bgcolor="white"; nodesep=0.3; ranksep=0.42; pad=0.3;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11.5, margin="0.14,0.08", fillcolor="#F4F4F4", color="#666666", penwidth=1.3];
  edge [fontname="Helvetica", fontsize=10, color="#555555", arrowsize=0.75];
  labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Which algorithm should I try first?";
  start [label="Start: do you have\nlabeled examples?", shape=diamond, fillcolor="#FFF3C4", color="#C9A100", margin="0.05,0.05"];
  unl [label="Explore unlabeled data", fillcolor="#DFF3E4", color="#2E8B57"];
  groups [label="Want groups?", shape=diamond, fillcolor="#FFF3C4", color="#C9A100"];
  km [label="k-means (round clusters)\nDBSCAN (odd shapes, outliers)\nHierarchical (dendrogram)", fillcolor="#DFF3E4", color="#2E8B57"];
  pca [label="PCA to compress / visualize", fillcolor="#DFF3E4", color="#2E8B57"];
  tgt [label="Target is a number\nor a category?", shape=diamond, fillcolor="#FFF3C4", color="#C9A100"];
  base [label="Baseline first:\nLinear regression (Ridge)\nor Logistic regression", fillcolor="#DCE9FF", color="#3B6EDC"];
  enough [label="Good enough\nand explainable?", shape=diamond, fillcolor="#FFF3C4", color="#C9A100"];
  done [label="Ship the simple model", fillcolor="#FFE9D2", color="#D9822B"];
  kind [label="What kind of data?", shape=diamond, fillcolor="#FFF3C4", color="#C9A100"];
  tab [label="Tabular, mixed columns:\nGradient boosting (XGBoost / LightGBM)\nthen Random forest", fillcolor="#DCE9FF", color="#3B6EDC"];
  txt [label="Text, little data:\nNaive Bayes or\nLogistic regression on word counts", fillcolor="#DCE9FF", color="#3B6EDC"];
  small [label="Small / medium, high-dimensional,\nclear margin: SVM (RBF)", fillcolor="#DCE9FF", color="#3B6EDC"];
  rules [label="Need human-readable rules:\nshallow Decision tree", fillcolor="#DCE9FF", color="#3B6EDC"];
  start -> unl [label="no"]; start -> tgt [label="yes"];
  unl -> groups; groups -> km [label="yes"]; groups -> pca [label="no (fewer features)"];
  tgt -> base [label="either"]; base -> enough;
  enough -> done [label="yes"]; enough -> kind [label="no"];
  kind -> tab [label="tables"]; kind -> txt [label="text"]; kind -> small [label="small n,\nmany features"]; kind -> rules [label="rules needed"];
}
